# Backend values: configure on the Convex DEVELOPMENT deployment.
# Local copies are ignored. Nothing here belongs in a VITE_* variable.
CLERK_JWT_ISSUER_DOMAIN=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
AGENTMAIL_API_KEY=
TYPESAFE_API_KEY=
FLOWSTATE_AGENTMAIL_INBOX_ID=
# Comma-separated addresses you explicitly approve for test email.
FLOWSTATE_ALLOWED_TEST_RECIPIENTS=
# Choose tested models available to your account; no silent latest alias.
FLOWSTATE_PLANNER_MODEL=
FLOWSTATE_JEV_MODEL=

# Optional comma-separated research host allowlist (e.g. docs.convex.dev).
FLOWSTATE_ALLOWED_SOURCE_HOSTS=
