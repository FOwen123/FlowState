{
  "name": "flowstate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "test:native": "swift test --package-path apps/macos",
    "dev:web": "vite apps/web --host 127.0.0.1",
    "test:web": "vitest run tests/web",
    "convex:codegen": "convex codegen",
    "test:browser": "playwright test",
    "format:check": "prettier --check apps/web/src tests/web tests/browser scripts package.json playwright.config.ts vitest.config.ts tsconfig.json"
  },
  "dependencies": {
    "@clerk/react": "^6.16.1",
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svix": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.59",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
